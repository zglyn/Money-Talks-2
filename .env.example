# Copy to `.env` and fill in real values. Never commit `.env`.

# Simulated Issuer Ledger file (optional)
CREDITPOOL_DB=creditpool.db

# PRISM live tracing (required for dashboard sessions)
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_ORG_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# Optional: real Nicrron model calls for the agent (reasoning only)
NICRRON_API_KEY=
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=nicrron/auto
